{
  "name": "fitmaster",
  "version": "1.0.0",
  "description": "> 单文件、纯本地、零依赖的全功能健身管理 App。打开 `index.html` 就能用。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:web": "rm -rf www && mkdir -p www/src-mobile && cp index.html www/index.html && cp -r src-mobile/. www/src-mobile/",
    "sync": "npm run build:web && npx cap sync ios",
    "ios": "npm run sync && npx cap open ios",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etherimirr/fitmaster.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/etherimirr/fitmaster/issues"
  },
  "homepage": "https://github.com/etherimirr/fitmaster#readme",
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.3",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.1.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  }
}
